# Nuvin Content Engine, environment config.
# Copy to .env (which is gitignored) and fill in real values.
# The OpenAI key should be a SEPARATE key named "nuvin" (not the Vylo key).

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-REPLACE-ME
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSLATE_MODEL=gpt-5.6-luna

# --- Publishing ---
# The Nuvin engine publishes by committing MDX files + updating lib/blog.ts,
# then pushing so Vercel deploys. No WordPress or SSH needed.
# 'live' commits and pushes. 'draft' writes files locally without pushing.
PUBLISH_MODE=draft

# Git identity used for the auto-commit (CI overrides these).
GIT_AUTHOR_NAME=Nuvin Bot
GIT_AUTHOR_EMAIL=bot@nuvin.app
